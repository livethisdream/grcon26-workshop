options:
  parameters:
    author: GRCon26 workshop
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Three jumpers: DIO0-DIO4, DIO1-DIO5, DIO2-DIO6.


      SPI mode 0, bit-banged one bit per sample. Change spi_message and

      watch the MOSI trace change; the same bytes come back out of the

      decoder, which reads MOSI at each rising SCLK edge while CS is low.


      The buffer must be cyclic. Non-cyclic streaming underruns about half

      the time at 1 MS/s and drops samples in the middle of a frame.'
    copyright: ''
    description: Bit-banged SPI mode 0 out of DIO0-2, back in on DIO4-6, decoded to
      bytes.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: m2k_spi_loopback_continuous
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: M2K SPI loopback - continuous, three DIO pins
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: buffer_len
  id: variable
  parameters:
    comment: Whole frames, and a frame is a whole message. Both blocks use it.
    value: frame * repeats
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 80.0]
    rotation: 0
    state: enabled
- name: frame
  id: variable
  parameters:
    comment: One frame is one whole transaction. Fixed by spi_capacity, not by the
      message, because the sink's buffer size cannot change while it runs.
    value: 128 + 16 * half * spi_capacity
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [328, 8.0]
    rotation: 0
    state: enabled
- name: half
  id: variable
  parameters:
    comment: Samples per half clock. 8 at 1 MS/s is a 62.5 kHz SCLK.
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 8.0]
    rotation: 0
    state: enabled
- name: repeats
  id: variable
  parameters:
    comment: As many whole messages as fit a 16384-sample buffer.
    value: max(1, 16384 // frame)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 80.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 8.0]
    rotation: 0
    state: enabled
- name: spi_bits
  id: variable
  parameters:
    comment: MSB first, the way SPI sends it.
    value: "[[(byte >> (7 - i)) & 1 for i in range(8)]\n for byte in spi_bytes]"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 8.0]
    rotation: 0
    state: enabled
- name: spi_bytes
  id: variable
  parameters:
    comment: The message, cut to what the frame holds.
    value: '[ord(ch) for ch in str(spi_message)[:spi_capacity]]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 8.0]
    rotation: 0
    state: enabled
- name: spi_capacity
  id: variable
  parameters:
    comment: Longest message the frame has room for. Raise it and restart to send
      more; the frame grows with it whether or not you use the space.
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 8.0]
    rotation: 0
    state: enabled
- name: spi_cs
  id: variable
  parameters:
    comment: Asserted low once, across the whole message -- the only falling edge
      in the frame is the start of the message, which is what the capture triggers
      on.
    value: ([1] * 64 + [0] * (16 + 16 * half * len(spi_bytes)) + [1] * (48 + spi_pad))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [928, 8.0]
    rotation: 0
    state: enabled
- name: spi_message
  id: variable_qtgui_entry
  parameters:
    comment: Type here while it runs. Anything past spi_capacity is cut.
    entry_signal: returnPressed
    gui_hint: ''
    label: SPI message
    type: string
    value: M2K
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 8.0]
    rotation: 0
    state: enabled
- name: spi_mosi
  id: variable
  parameters:
    comment: Each bit is presented while SCLK is low, so it is already settled at
      the rising edge.
    value: ([0] * 64 + [spi_bits[0][0] if spi_bits else 0] * 8 + [b for bits in spi_bits
      for bit in bits for b in [bit] * (2 * half)] + [0] * (56 + spi_pad))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 8.0]
    rotation: 0
    state: enabled
- name: spi_pad
  id: variable
  parameters:
    comment: Idle samples that keep a short message the same length as a full one.
      CS is already high here, so the decoder ignores all of it.
    value: 16 * half * (spi_capacity - len(spi_bytes))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 80.0]
    rotation: 0
    state: enabled
- name: spi_sclk
  id: variable
  parameters:
    comment: Idle low, eight pulses per byte with no gap between them, idle low.
    value: ([0] * 72 + ([0] * half + [1] * half) * (8 * len(spi_bytes)) + [0] * (56
      + spi_pad))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [928, 88.0]
    rotation: 0
    state: enabled
- name: cs_f
  id: blocks_short_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 664.0]
    rotation: 0
    state: enabled
- name: cs_src
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: CS -> DIO2
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: short
    vector: spi_cs
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 488.0]
    rotation: 0
    state: enabled
- name: m2k_digital_sink_0
  id: m2k_digital_sink
  parameters:
    affinity: ''
    alias: ''
    buffer_size: buffer_len
    comment: 'Whole messages per buffer, pushed once and

      repeated by the hardware.'
    cyclic: 'True'
    drive: '''push-pull'''
    idle_level: '''low'''
    name0: SCLK
    name1: MOSI
    name10: ''
    name11: ''
    name12: ''
    name13: ''
    name14: ''
    name15: ''
    name2: CS
    name3: ''
    name4: ''
    name5: ''
    name6: ''
    name7: ''
    name8: ''
    name9: ''
    num_lines: '3'
    pin0: '0'
    pin1: '1'
    pin10: '10'
    pin11: '11'
    pin12: '12'
    pin13: '13'
    pin14: '14'
    pin15: '15'
    pin2: '2'
    pin3: '3'
    pin4: '4'
    pin5: '5'
    pin6: '6'
    pin7: '7'
    pin8: '8'
    pin9: '9'
    sample_rate: '1000000'
    uri: ip:192.168.2.1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 260.0]
    rotation: 0
    state: enabled
- name: m2k_digital_source_0
  id: m2k_digital_source
  parameters:
    affinity: ''
    alias: ''
    buffer_size: buffer_len
    comment: 'Triggered on CS falling, so every capture

      starts at the head of a frame.'
    maxoutbuf: '0'
    minoutbuf: '0'
    name0: SCLK
    name1: MOSI
    name10: ''
    name11: ''
    name12: ''
    name13: ''
    name14: ''
    name15: ''
    name2: CS
    name3: ''
    name4: ''
    name5: ''
    name6: ''
    name7: ''
    name8: ''
    name9: ''
    num_lines: '3'
    pin0: '4'
    pin1: '5'
    pin10: '10'
    pin11: '11'
    pin12: '12'
    pin13: '13'
    pin14: '14'
    pin15: '15'
    pin2: '6'
    pin3: '3'
    pin4: '4'
    pin5: '5'
    pin6: '6'
    pin7: '7'
    pin8: '8'
    pin9: '9'
    sample_rate: '1000000'
    trigger_condition: '''edge-falling'''
    trigger_delay: '0'
    trigger_pin: '6'
    uri: ip:192.168.2.1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 548.0]
    rotation: 0
    state: enabled
- name: message_debug_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: Prints the bytes as they arrive.
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 368.0]
    rotation: 0
    state: enabled
- name: mosi_f
  id: blocks_short_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 584.0]
    rotation: 0
    state: enabled
- name: mosi_src
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: MOSI -> DIO1
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: short
    vector: spi_mosi
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [48, 360.0]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: Two frames wide, whatever `half` is set to.
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: SCLK
    label10: Signal 10
    label2: MOSI
    label3: CS
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"SPI mode 0 - captured on DIO4-6"'
    nconnections: '3'
    size: 2 * frame
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Volts
    ymax: '1.5'
    ymin: '-0.5'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [856, 528.0]
    rotation: 0
    state: enabled
- name: sclk_f
  id: blocks_short_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 504.0]
    rotation: 0
    state: enabled
- name: sclk_src
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: SCLK -> DIO0
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: short
    vector: spi_sclk
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [64, 248.0]
    rotation: 0
    state: enabled
- name: spi_decode_0
  id: m2k_spi_decode
  parameters:
    affinity: ''
    alias: ''
    bits_per_word: '8'
    comment: 'The three streams back into bytes.

      Nothing here touches the board.'
    cs_active_low: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 368.0]
    rotation: 0
    state: enabled

connections:
- [cs_f, '0', qtgui_time_sink_x_0, '2']
- [cs_src, '0', m2k_digital_sink_0, '2']
- [m2k_digital_source_0, '0', sclk_f, '0']
- [m2k_digital_source_0, '0', spi_decode_0, '0']
- [m2k_digital_source_0, '1', mosi_f, '0']
- [m2k_digital_source_0, '1', spi_decode_0, '1']
- [m2k_digital_source_0, '2', cs_f, '0']
- [m2k_digital_source_0, '2', spi_decode_0, '2']
- [mosi_f, '0', qtgui_time_sink_x_0, '1']
- [mosi_src, '0', m2k_digital_sink_0, '1']
- [sclk_f, '0', qtgui_time_sink_x_0, '0']
- [sclk_src, '0', m2k_digital_sink_0, '0']
- [spi_decode_0, bytes, message_debug_0, print_pdu]

metadata:
  file_format: 1
  grc_version: 3.10.9.2
